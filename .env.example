# Copy to .env to override the defaults used by docker-compose.yml.
# docker compose up works without a .env file; these are safe local development defaults.

# PostgreSQL
POSTGRES_DB=school_admission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
ASPNETCORE_ENVIRONMENT=Production
HOLD_DURATION_SECONDS=600
# The backend reads its database connection from ConnectionStrings__DefaultConnection.
# docker-compose.yml builds it from the POSTGRES_* values above, e.g.
# Host=postgres;Port=5432;Database=school_admission;Username=postgres;Password=postgres

# Frontend (must be reachable from the browser, not a Docker service name)
VITE_API_BASE_URL=http://localhost:8080
